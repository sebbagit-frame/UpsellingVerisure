# Contraseña única compartida por todo el sector para acceder al sitio (rol sector, solo lectura).
# Elegir una frase larga y difícil de adivinar; se comparte solo con los operadores.
SITE_PASSWORD=

# Contraseña de administrador (rol admin): habilita el acceso a /admin con permisos de escritura.
# Debe ser distinta de SITE_PASSWORD y compartirse solo con los responsables del contenido.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión con HMAC-SHA256.
# Generarlo con: openssl rand -hex 32
# No compartirlo ni reutilizarlo en otros servicios.
SESSION_SECRET=

# URL del proyecto de Supabase.
# Se obtiene en el panel de Supabase: Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon) del proyecto de Supabase.
# Se obtiene en el panel de Supabase: Settings → API → Project API keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
