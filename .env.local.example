# Contraseña única compartida por todo el sector para acceder al sitio.
# Elegir una frase larga y difícil de adivinar; se comparte solo con los operadores.
SITE_PASSWORD=

# Secreto para firmar la cookie de sesión con HMAC-SHA256.
# Generarlo con: openssl rand -hex 32
# No compartirlo ni reutilizarlo en otros servicios.
SESSION_SECRET=
